# --- Base de données (docker compose up -d postgres) ---
DATABASE_URL="postgresql://ghom:ghom@localhost:5432/ghom_hub?schema=public"
# Optionnel : URL directe pour les migrations (Neon : celle sans "-pooler")
# DIRECT_DATABASE_URL=""

# --- Domaines ---
# En prod : ghom.fr / https. En dev, *.localhost résout vers 127.0.0.1 dans les navigateurs modernes.
NEXT_PUBLIC_ROOT_DOMAIN="localhost"
NEXT_PUBLIC_STUDIO_LABEL="nobrainnogame"
NEXT_PUBLIC_PROTOCOL="http"
# URLs explicites des deux hubs (en dev ils tournent sur deux ports différents)
NEXT_PUBLIC_HUB_URL="http://localhost:3000"
NEXT_PUBLIC_STUDIO_URL="http://localhost:3001"

# --- Admin (admin.ghom.fr · port 3002 en dev) ---
# Génère les trois secrets avec : bun --cwd apps/admin run admin:hash
ADMIN_PASSWORD_HASH=""
SESSION_SECRET=""
# Partagé entre l'admin et les deux sites (revalidation immédiate après une modification)
REVALIDATE_SECRET=""
# Adresses internes des sites, appelées par l'admin
HUB_INTERNAL_URL="http://localhost:3000"
STUDIO_INTERNAL_URL="http://localhost:3001"
