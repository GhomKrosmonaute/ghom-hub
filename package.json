{
  "name": "ghom-hub",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "biome check . && turbo run typecheck test",
    "db:up": "docker compose up -d postgres",
    "db:generate": "turbo run db:generate",
    "db:migrate": "bun --cwd packages/db run db:migrate",
    "db:deploy": "bun --cwd packages/db run db:deploy",
    "db:seed": "bun --cwd packages/db run db:seed",
    "db:studio": "bun --cwd packages/db run db:studio",
    "brand": "bun brand/generate.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
